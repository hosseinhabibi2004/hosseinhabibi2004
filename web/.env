# Committed defaults — safe, non-secret values every dev/CI can run with as-is.
# Personal overrides go in .env.local (gitignored), never here.

# Where the site is served. A project page on GitHub Pages is
# https://<user>.github.io/<repo>, so set the base path to /<repo> in that case.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=

# The Django API the site reads once, at build time (never at runtime).
BACKEND_API_URL=http://localhost:8000
