{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd api && .venv/bin/python manage.py runserver 8010"
      ],
      "port": 8010
    },
    {
      "name": "admin",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.nvm/versions/node/v24.19.0/bin:$PATH && cd admin && pnpm dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.nvm/versions/node/v24.19.0/bin:$PATH && cd web && pnpm exec next dev -p 3010"
      ],
      "port": 3010
    }
  ]
}