# Django Core Settings
# SECRET_KEY is generated into .env on first run when empty.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=en
TIME_ZONE=Asia/Tehran

# Database. Empty = SQLite at backend/db.sqlite3 (back this file up: the content
# lives only here, not in git). For PostgreSQL:
#   DATABASE_URL=postgres://user:password@localhost:5432/name
DATABASE_URL=

# Where the browser reaches the public site (3000), the local admin app (3001)
# and this Django process.
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
BACKEND_ORIGIN=http://localhost:8000

# CORS Configuration (Next.js dev server calling this process).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Sign-in protection: per-IP cap on password attempts.
# LOGIN_THROTTLE_RATE=30/minute

# Image uploads: largest file (bytes) and longest side (pixels).
# IMAGE_MAX_BYTES=5242880
# IMAGE_MAX_SIDE=4000
